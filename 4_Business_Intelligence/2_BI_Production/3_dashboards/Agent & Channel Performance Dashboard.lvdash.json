{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Sales KPIs",
      "queryLines": [
        "SELECT\n",
        "  SUM(finalprice) AS total_revenue,\n",
        "  COUNT(DISTINCT OrderID) AS total_orders,\n",
        "  COUNT(DISTINCT AgentSK) AS active_agents,\n",
        "  AVG(finalprice) AS avg_order_value\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "top_agents_revenue",
      "displayName": "Top 10 Agents by Revenue",
      "queryLines": [
        "SELECT\n",
        "  a.AgentName,\n",
        "  SUM(s.finalprice) AS total_revenue\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales s\n",
        "    INNER JOIN sap_dev.silver.dim_agent a\n",
        "      ON s.AgentSK = a.AgentSK\n",
        "GROUP BY\n",
        "  a.AgentName\n",
        "ORDER BY\n",
        "  total_revenue DESC\n",
        "LIMIT 10"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "top_retailers_revenue",
      "displayName": "Top 10 Retailers by Revenue",
      "queryLines": [
        "SELECT\n",
        "  r.RetailerName,\n",
        "  SUM(s.finalprice) AS total_revenue\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales s\n",
        "    INNER JOIN sap_dev.silver.dim_retailer r\n",
        "      ON s.RetailerSK = r.RetailerSK\n",
        "GROUP BY\n",
        "  r.RetailerName\n",
        "ORDER BY\n",
        "  total_revenue DESC\n",
        "LIMIT 10"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "agent_performance_table",
      "displayName": "Agent Performance Details",
      "queryLines": [
        "SELECT\n",
        "  a.AgentName,\n",
        "  a.AgentCity,\n",
        "  SUM(s.finalprice) AS total_revenue,\n",
        "  COUNT(DISTINCT s.OrderID) AS total_orders,\n",
        "  AVG(s.finalprice) AS avg_order_value\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales s\n",
        "    INNER JOIN sap_dev.silver.dim_agent a\n",
        "      ON s.AgentSK = a.AgentSK\n",
        "GROUP BY\n",
        "  a.AgentName,\n",
        "  a.AgentCity\n",
        "ORDER BY\n",
        "  total_revenue DESC\n",
        "LIMIT 20"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "wholesaler_volume",
      "displayName": "Wholesaler Volume",
      "queryLines": [
        "SELECT\n",
        "  w.WholeSalerName,\n",
        "  SUM(p.Quantity) AS total_quantity\n",
        "FROM\n",
        "  sap_dev.silver.fact_purchase p\n",
        "    INNER JOIN sap_dev.silver.dim_wholesaler w\n",
        "      ON p.WholesalerSK = w.WholeSalerSK\n",
        "GROUP BY\n",
        "  w.WholeSalerName\n",
        "ORDER BY\n",
        "  total_quantity DESC"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "filter_agents",
      "displayName": "Agent Filter",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  AgentName\n",
        "FROM\n",
        "  sap_dev.silver.dim_agent\n",
        "ORDER BY\n",
        "  AgentName"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "top_agents_orders",
      "displayName": "Top 10 Agents by Orders",
      "queryLines": [
        "SELECT\n",
        "  a.AgentName,\n",
        "  COUNT(DISTINCT s.OrderID) AS total_orders\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales s\n",
        "    INNER JOIN sap_dev.silver.dim_agent a\n",
        "      ON s.AgentSK = a.AgentSK\n",
        "GROUP BY\n",
        "  a.AgentName\n",
        "ORDER BY\n",
        "  total_orders DESC\n",
        "LIMIT 10"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "filter_retailers",
      "displayName": "Retailer Filter",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  RetailerName\n",
        "FROM\n",
        "  sap_dev.silver.dim_retailer\n",
        "ORDER BY\n",
        "  RetailerName"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "filter_retailer_cities",
      "displayName": "Retailer City Filter",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  RetailerCity\n",
        "FROM\n",
        "  sap_dev.silver.dim_retailer\n",
        "ORDER BY\n",
        "  RetailerCity"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "filter_agent_cities",
      "displayName": "Agent City Filter",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  AgentCity\n",
        "FROM\n",
        "  sap_dev.silver.dim_agent\n",
        "ORDER BY\n",
        "  AgentCity"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    }
  ],
