{
  "datasets": [
    {
      "name": "po_details",
      "displayName": "Purchase Order Details",
      "queryLines": [
        "SELECT\n",
        "  fp.PurchaseID,\n",
        "  fp.PurchaseDate,\n",
        "  ws.WholeSalerName as Vendor,\n",
        "  p.ProductName as Product,\n",
        "  wh.WareHouseName as Warehouse,\n",
        "  fp.Quantity,\n",
        "  fp.UnitCost,\n",
        "  fp.NetAmount as POValue\n",
        "FROM\n",
        "  sap_dev.silver.fact_purchase fp\n",
        "    INNER JOIN sap_dev.silver.dim_wholesaler ws\n",
        "      ON fp.WholesalerSK = ws.WholeSalerSK\n",
        "    INNER JOIN sap_dev.silver.dim_product p\n",
        "      ON fp.ProductSK = p.ProductSK\n",
        "    INNER JOIN sap_dev.silver.dim_warehouse wh\n",
        "      ON fp.WarehouseSK = wh.WareHouseSK\n",
        "ORDER BY\n",
        "  fp.NetAmount DESC"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "vendor_count",
      "displayName": "Vendor PO Count",
      "queryLines": [
        "SELECT\n",
        "  ws.WholeSalerName,\n",
        "  COUNT(fp.PurchaseID) as POCount\n",
        "FROM\n",
        "  sap_dev.silver.fact_purchase fp\n",
        "    INNER JOIN sap_dev.silver.dim_wholesaler ws\n",
        "      ON fp.WholesalerSK = ws.WholeSalerSK\n",
        "GROUP BY\n",
        "  ws.WholeSalerName\n",
        "ORDER BY\n",
        "  POCount DESC"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "daily_trend",
      "displayName": "Daily Purchase Trend",
      "queryLines": [
        "SELECT\n",
        "  PurchaseDate,\n",
        "  SUM(NetAmount) as DailyValue\n",
        "FROM\n",
        "  sap_dev.silver.fact_purchase\n",
        "GROUP BY\n",
        "  PurchaseDate\n",
        "ORDER BY\n",
        "  PurchaseDate"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "warehouse_value",
      "displayName": "Top 10 Warehouse Purchase Value",
      "queryLines": [
        "SELECT\n",
        "  wh.WareHouseName,\n",
        "  SUM(fp.NetAmount) as TotalValue\n",
        "FROM\n",
        "  sap_dev.silver.fact_purchase fp\n",
        "    INNER JOIN sap_dev.silver.dim_warehouse wh\n",
        "      ON fp.WarehouseSK = wh.WareHouseSK\n",
        "GROUP BY\n",
        "  wh.WareHouseName\n",
        "ORDER BY\n",
        "  TotalValue DESC\n",
        "LIMIT 10"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "kpis",
      "displayName": "KPI Metrics",
      "queryLines": [
        "SELECT\n",
        "  SUM(NetAmount) as TotalPurchaseValue,\n",
        "  COUNT(DISTINCT PurchaseID) as TotalPurchaseOrders,\n",
        "  AVG(NetAmount) as AvgPOValue,\n",
        "  COUNT(DISTINCT WholesalerSK) as ActiveVendors\n",
        "FROM\n",
        "  sap_dev.silver.fact_purchase"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "vendor_value",
      "displayName": "Vendor Purchase Value",
      "queryLines": [
        "SELECT\n",
        "  ws.WholeSalerName,\n",
        "  SUM(fp.NetAmount) as TotalValue\n",
        "FROM\n",
        "  sap_dev.silver.fact_purchase fp\n",
        "    INNER JOIN sap_dev.silver.dim_wholesaler ws\n",
        "      ON fp.WholesalerSK = ws.WholeSalerSK\n",
        "GROUP BY\n",
        "  ws.WholeSalerName\n",
        "ORDER BY\n",
        "  TotalValue DESC"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "top_products",
      "displayName": "Top Products by Value",
      "queryLines": [
        "SELECT\n",
        "  p.ProductName,\n",
        "  SUM(fp.NetAmount) as TotalValue\n",
        "FROM\n",
        "  sap_dev.silver.fact_purchase fp\n",
        "    INNER JOIN sap_dev.silver.dim_product p\n",
        "      ON fp.ProductSK = p.ProductSK\n",
        "GROUP BY\n",
        "  p.ProductName\n",
        "ORDER BY\n",
        "  TotalValue DESC\n",
        "LIMIT 10"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "filter_products",
      "displayName": "Product Filter Options",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  p.ProductName\n",
        "FROM\n",
        "  sap_dev.silver.fact_purchase fp\n",
        "    INNER JOIN sap_dev.silver.dim_product p\n",
        "      ON fp.ProductSK = p.ProductSK\n",
        "ORDER BY\n",
        "  p.ProductName"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "filter_vendors",
      "displayName": "Vendor Filter Options",
      "queryLines": [
        "SELECT\n",
        "  ws.WholeSalerName\n",
        "FROM\n",
        "  sap_dev.silver.fact_purchase fp\n",
        "    INNER JOIN sap_dev.silver.dim_wholesaler ws\n",
        "      ON fp.WholesalerSK = ws.WholeSalerSK\n",
        "GROUP BY\n",
        "  ws.WholeSalerName"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    }
  ],
