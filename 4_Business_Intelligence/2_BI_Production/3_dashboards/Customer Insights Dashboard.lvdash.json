{
  "datasets": [
    {
      "name": "customer_insights",
      "displayName": "Customer Insights",
      "config": {
        "version": "1.1",
        "source": "SELECT c360.CustomerKey as CustomerSK, c360.CustomerName, c360.TotalSpend as lifetime_value, c360.TotalPurchases as total_orders, c360.DaysSinceLastPurchase as days_since_last_purchase, c360.CustomerSegment as customer_segment, c360.AvgOrderValue as avg_order_value, c360.FirstPurchaseDate as first_purchase_date, c360.LastPurchaseDate as last_purchase_date, rfm.Recency, rfm.Frequency, rfm.Monetary_Lakhs, rfm.R_Score, rfm.F_Score, rfm.M_Score, rfm.RFM_Score, COALESCE(rfm.Segment, 'Unclassified') as RFM_Segment, CASE WHEN c360.TotalSpend < 1000 THEN 'Under ₹1K' WHEN c360.TotalSpend < 5000 THEN '₹1K-5K' WHEN c360.TotalSpend < 10000 THEN '₹5K-10K' WHEN c360.TotalSpend < 25000 THEN '₹10K-25K' WHEN c360.TotalSpend < 50000 THEN '₹25K-50K' WHEN c360.TotalSpend < 100000 THEN '₹50K-100K' ELSE '₹100K+' END as LTV_Band, CASE WHEN c360.TotalPurchases = 1 THEN '1 Order' WHEN c360.TotalPurchases = 2 THEN '2 Orders' WHEN c360.TotalPurchases BETWEEN 3 AND 5 THEN '3-5 Orders' WHEN c360.TotalPurchases BETWEEN 6 AND 10 THEN '6-10 Orders' ELSE '10+ Orders' END as Order_Frequency_Band FROM sap_dev.gold.mart_customer_360 c360 LEFT JOIN sap_dev.gold.mart_rfm_analysis rfm ON c360.CustomerKey = rfm.CustomerSK WHERE c360.CustomerKey > 0 ",
        "dimensions": [
          {
            "name": "CustomerSK",
            "expr": "CustomerSK"
          },
          {
            "name": "CustomerName",
            "expr": "CustomerName"
          },
          {
            "name": "customer_segment",
            "expr": "customer_segment"
          },
          {
            "name": "RFM_Segment",
            "expr": "RFM_Segment"
          },
          {
            "name": "first_purchase_date",
            "expr": "first_purchase_date"
          },
          {
            "name": "last_purchase_date",
            "expr": "last_purchase_date"
          },
          {
            "name": "LTV_Band",
            "expr": "LTV_Band"
          },
          {
            "name": "Order_Frequency_Band",
            "expr": "Order_Frequency_Band"
          }
        ],
        "measures": [
          {
            "name": "total_customers",
            "expr": "COUNT(DISTINCT CustomerSK)"
          },
          {
            "name": "active_customers",
            "expr": "COUNT(DISTINCT CASE WHEN days_since_last_purchase <= 30 THEN CustomerSK END)"
          },
          {
            "name": "champions_count",
            "expr": "COUNT(DISTINCT CASE WHEN RFM_Segment = 'Champions' THEN CustomerSK END)"
          },
          {
            "name": "at_risk_count",
            "expr": "COUNT(DISTINCT CASE WHEN RFM_Segment = 'At Risk' THEN CustomerSK END)"
          },
          {
            "name": "hibernating_count",
            "expr": "COUNT(DISTINCT CASE WHEN RFM_Segment = 'Hibernating' THEN CustomerSK END)"
          },
          {
            "name": "customers_at_risk",
            "expr": "COUNT(DISTINCT CASE WHEN RFM_Segment IN ('At Risk', 'Hibernating') THEN CustomerSK END)"
          },
          {
            "name": "risk_rate_pct",
            "expr": "100.0 * COUNT(DISTINCT CASE WHEN RFM_Segment IN ('At Risk', 'Hibernating') THEN CustomerSK END) / COUNT(DISTINCT CustomerSK)"
          },
          {
            "name": "high_value_customers",
            "expr": "COUNT(DISTINCT CASE WHEN customer_segment IN ('VIP', 'High Value') THEN CustomerSK END)"
          },
          {
            "name": "high_value_pct",
            "expr": "100.0 * COUNT(DISTINCT CASE WHEN customer_segment IN ('VIP', 'High Value') THEN CustomerSK END) / COUNT(DISTINCT CustomerSK)"
          },
          {
            "name": "total_lifetime_value",
            "expr": "SUM(lifetime_value)"
          },
          {
            "name": "avg_lifetime_value",
            "expr": "AVG(lifetime_value)"
          },
          {
            "name": "total_orders_sum",
            "expr": "SUM(total_orders)"
          },
          {
            "name": "avg_order_value_avg",
            "expr": "AVG(avg_order_value)"
          },
          {
            "name": "lifetime_value",
            "expr": "SUM(lifetime_value)"
          },
          {
            "name": "total_orders",
            "expr": "SUM(total_orders)"
          },
          {
            "name": "days_since_last_purchase",
            "expr": "AVG(days_since_last_purchase)"
          },
          {
            "name": "Recency",
            "expr": "AVG(Recency)"
          },
          {
            "name": "Frequency",
            "expr": "AVG(Frequency)"
          },
          {
            "name": "Monetary_Lakhs",
            "expr": "SUM(Monetary_Lakhs)"
          }
        ]
      }
    }
  ],
