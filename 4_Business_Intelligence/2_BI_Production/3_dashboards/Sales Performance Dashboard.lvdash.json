{
  "datasets": [
    {
      "name": "sales_kpi_mtd",
      "displayName": "Sales KPI MTD with Comparison",
      "queryLines": [
        "WITH current_month AS (\n",
        "  SELECT\n",
        "    SUM(fs.finalprice) AS revenue_mtd,\n",
        "    COUNT(DISTINCT fs.OrderID) AS orders_mtd\n",
        "  FROM\n",
        "    sap_dev.silver.fact_sales fs\n",
        "      INNER JOIN sap_dev.silver.dim_date dd\n",
        "        ON fs.OrderDateID = dd.DateID\n",
        "  WHERE\n",
        "    dd.Date >= DATE_TRUNC('MONTH', CURRENT_DATE())\n",
        "    AND dd.Date <= CURRENT_DATE()\n",
        "),\n",
        "previous_month AS (\n",
        "  SELECT\n",
        "    SUM(fs.finalprice) AS revenue_prev,\n",
        "    COUNT(DISTINCT fs.OrderID) AS orders_prev\n",
        "  FROM\n",
        "    sap_dev.silver.fact_sales fs\n",
        "      INNER JOIN sap_dev.silver.dim_date dd\n",
        "        ON fs.OrderDateID = dd.DateID\n",
        "  WHERE\n",
        "    dd.Date >= ADD_MONTHS(DATE_TRUNC('MONTH', CURRENT_DATE()), -1)\n",
        "    AND dd.Date < DATE_TRUNC('MONTH', CURRENT_DATE())\n",
        ")\n",
        "SELECT\n",
        "  cm.revenue_mtd,\n",
        "  cm.orders_mtd,\n",
        "  pm.revenue_prev AS revenue_prev_month,\n",
        "  pm.orders_prev AS orders_prev_month,\n",
        "  CASE\n",
        "    WHEN\n",
        "      pm.revenue_prev > 0\n",
        "    THEN\n",
        "      ROUND(((cm.revenue_mtd - pm.revenue_prev) / pm.revenue_prev) * 100, 1)\n",
        "    ELSE NULL\n",
        "  END AS revenue_mom_growth_pct,\n",
        "  CASE\n",
        "    WHEN\n",
        "      pm.orders_prev > 0\n",
        "    THEN\n",
        "      ROUND(((cm.orders_mtd - pm.orders_prev) / CAST(pm.orders_prev AS DECIMAL)) * 100, 1)\n",
        "    ELSE NULL\n",
        "  END AS orders_mom_growth_pct\n",
        "FROM\n",
        "  current_month cm CROSS JOIN previous_month pm"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "sales_kpi_aov",
      "displayName": "AOV with Comparison",
      "queryLines": [
        "WITH current_month AS (\n",
        "  SELECT\n",
        "    SUM(fs.finalprice) / NULLIF(COUNT(DISTINCT fs.OrderID), 0) AS avg_order_value\n",
        "  FROM\n",
        "    sap_dev.silver.fact_sales fs\n",
        "      INNER JOIN sap_dev.silver.dim_date dd\n",
        "        ON fs.OrderDateID = dd.DateID\n",
        "  WHERE\n",
        "    dd.Date >= DATE_TRUNC('MONTH', CURRENT_DATE())\n",
        "    AND dd.Date <= CURRENT_DATE()\n",
        "),\n",
        "previous_month AS (\n",
        "  SELECT\n",
        "    SUM(fs.finalprice) / NULLIF(COUNT(DISTINCT fs.OrderID), 0) AS aov_prev\n",
        "  FROM\n",
        "    sap_dev.silver.fact_sales fs\n",
        "      INNER JOIN sap_dev.silver.dim_date dd\n",
        "        ON fs.OrderDateID = dd.DateID\n",
        "  WHERE\n",
        "    dd.Date >= ADD_MONTHS(DATE_TRUNC('MONTH', CURRENT_DATE()), -1)\n",
        "    AND dd.Date < DATE_TRUNC('MONTH', CURRENT_DATE())\n",
        ")\n",
        "SELECT\n",
        "  cm.avg_order_value,\n",
        "  pm.aov_prev AS aov_prev_month,\n",
        "  CASE\n",
        "    WHEN pm.aov_prev > 0 THEN ROUND(((cm.avg_order_value - pm.aov_prev) / pm.aov_prev) * 100, 1)\n",
        "    ELSE NULL\n",
        "  END AS aov_mom_growth_pct\n",
        "FROM\n",
        "  current_month cm CROSS JOIN previous_month pm"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "sales_kpi_today",
      "displayName": "Sales KPI Today with Context",
      "queryLines": [
        "WITH latest_date AS (\n",
        "  SELECT\n",
        "    MAX(dd.Date) AS latest_sales_date\n",
        "  FROM\n",
        "    sap_dev.silver.fact_sales fs\n",
        "      INNER JOIN sap_dev.silver.dim_date dd\n",
        "        ON fs.OrderDateID = dd.DateID\n",
        "),\n",
        "today_sales AS (\n",
        "  SELECT\n",
        "    COALESCE(SUM(fs.finalprice), 0) AS revenue_today,\n",
        "    COUNT(DISTINCT fs.OrderID) AS orders_today\n",
        "  FROM\n",
        "    sap_dev.silver.fact_sales fs\n",
        "      INNER JOIN sap_dev.silver.dim_date dd\n",
        "        ON fs.OrderDateID = dd.DateID\n",
        "  WHERE\n",
        "    dd.Date\n",
        "      = (\n",
        "        SELECT\n",
        "          MAX(dd2.Date)\n",
        "        FROM\n",
        "          sap_dev.silver.fact_sales fs2\n",
        "            INNER JOIN sap_dev.silver.dim_date dd2\n",
        "              ON fs2.OrderDateID = dd2.DateID\n",
        "      )\n",
        ")\n",
        "SELECT\n",
        "  ts.revenue_today,\n",
        "  ts.orders_today,\n",
        "  ld.latest_sales_date,\n",
        "  CASE\n",
        "    WHEN ts.orders_today = 0 THEN 'No sales data available'\n",
        "    ELSE CAST(ts.revenue_today AS STRING)\n",
        "  END AS revenue_today_display\n",
        "FROM\n",
        "  today_sales ts CROSS JOIN latest_date ld"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "sales_by_agent_city",
      "displayName": "Sales by Agent City",
      "queryLines": [
        "SELECT\n",
        "  da.AgentCity AS agent_city,\n",
        "  SUM(fs.finalprice) AS total_revenue\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales fs\n",
        "    INNER JOIN sap_dev.silver.dim_agent da\n",
        "      ON fs.AgentSK = da.AgentSK\n",
        "GROUP BY\n",
        "  da.AgentCity\n",
        "ORDER BY\n",
        "  total_revenue DESC"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "sales_by_agent",
      "displayName": "Sales by Agent",
      "queryLines": [
        "SELECT\n",
        "  da.AgentName AS agent_name,\n",
        "  SUM(fs.finalprice) AS agent_revenue\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales fs\n",
        "    INNER JOIN sap_dev.silver.dim_agent da\n",
        "      ON fs.AgentSK = da.AgentSK\n",
        "GROUP BY\n",
        "  da.AgentName\n",
        "ORDER BY\n",
        "  agent_revenue DESC"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "daily_sales_trend",
      "displayName": "Daily Sales Trend - Last 30 Days",
      "queryLines": [
        "SELECT\n",
        "  dd.Date AS order_date,\n",
        "  SUM(fs.finalprice) AS daily_revenue\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales fs\n",
        "    INNER JOIN sap_dev.silver.dim_date dd\n",
        "      ON fs.OrderDateID = dd.DateID\n",
        "WHERE\n",
        "  dd.Date >= CURRENT_DATE() - INTERVAL 30 DAYS\n",
        "  AND dd.Date <= CURRENT_DATE()\n",
        "GROUP BY\n",
        "  dd.Date\n",
        "ORDER BY\n",
        "  dd.Date ASC"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "top_products_revenue",
      "displayName": "Top 10 Products by Revenue",
      "queryLines": [
        "SELECT\n",
        "  dp.ProductName AS product_name,\n",
        "  SUM(fs.finalprice) AS product_revenue\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales fs\n",
        "    INNER JOIN sap_dev.silver.dim_product dp\n",
        "      ON fs.ProductSK = dp.ProductSK\n",
        "GROUP BY\n",
        "  dp.ProductName\n",
        "ORDER BY\n",
        "  product_revenue DESC\n",
        "LIMIT 10"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "top_products_enhanced",
      "displayName": "Top 10 Products Enhanced",
      "queryLines": [
        "SELECT\n",
        "  dp.ProductName AS product,\n",
        "  dpc.ProductCategory AS category,\n",
        "  SUM(fs.finalprice) AS revenue,\n",
        "  SUM(fs.ProductQuantity) AS units_sold,\n",
        "  COUNT(DISTINCT fs.OrderID) AS orders\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales fs\n",
        "    INNER JOIN sap_dev.silver.dim_product dp\n",
        "      ON fs.ProductSK = dp.ProductSK\n",
        "    INNER JOIN sap_dev.silver.dim_product_category dpc\n",
        "      ON fs.ProductCategorySK = dpc.ProductCategorySK\n",
        "GROUP BY\n",
        "  dp.ProductName,\n",
        "  dpc.ProductCategory\n",
        "ORDER BY\n",
        "  revenue DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "top_agents_revenue",
      "displayName": "Top 10 Agents by Revenue",
      "queryLines": [
        "SELECT\n",
        "  da.AgentName AS agent,\n",
        "  da.AgentCity AS city,\n",
        "  SUM(fs.finalprice) AS revenue,\n",
        "  COUNT(DISTINCT fs.OrderID) AS orders\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales fs\n",
        "    INNER JOIN sap_dev.silver.dim_agent da\n",
        "      ON fs.AgentSK = da.AgentSK\n",
        "GROUP BY\n",
        "  da.AgentName,\n",
        "  da.AgentCity\n",
        "ORDER BY\n",
        "  revenue DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "revenue_contribution",
      "displayName": "Revenue Contribution Metrics",
      "queryLines": [
        "WITH total_revenue AS (\n",
        "  SELECT\n",
        "    SUM(finalprice) AS total\n",
        "  FROM\n",
        "    sap_dev.silver.fact_sales\n",
        "),\n",
        "top_cities AS (\n",
        "  SELECT\n",
        "    SUM(fs.finalprice) AS top_cities_revenue\n",
        "  FROM\n",
        "    sap_dev.silver.fact_sales fs\n",
        "      INNER JOIN sap_dev.silver.dim_agent da\n",
        "        ON fs.AgentSK = da.AgentSK\n",
        "  WHERE\n",
        "    da.AgentCity IN (\n",
        "      SELECT\n",
        "        AgentCity\n",
        "      FROM\n",
        "        (\n",
        "          SELECT\n",
        "            da2.AgentCity,\n",
        "            SUM(fs2.finalprice) AS rev\n",
        "          FROM\n",
        "            sap_dev.silver.fact_sales fs2\n",
        "              INNER JOIN sap_dev.silver.dim_agent da2\n",
        "                ON fs2.AgentSK = da2.AgentSK\n",
        "          GROUP BY\n",
        "            da2.AgentCity\n",
        "          ORDER BY\n",
        "            rev DESC\n",
        "          LIMIT 10\n",
        "        )\n",
        "    )\n",
        "),\n",
        "top_products AS (\n",
        "  SELECT\n",
        "    SUM(fs.finalprice) AS top_products_revenue\n",
        "  FROM\n",
        "    sap_dev.silver.fact_sales fs\n",
        "      INNER JOIN sap_dev.silver.dim_product dp\n",
        "        ON fs.ProductSK = dp.ProductSK\n",
        "  WHERE\n",
        "    dp.ProductName IN (\n",
        "      SELECT\n",
        "        ProductName\n",
        "      FROM\n",
        "        (\n",
        "          SELECT\n",
        "            dp2.ProductName,\n",
        "            SUM(fs2.finalprice) AS rev\n",
        "          FROM\n",
        "            sap_dev.silver.fact_sales fs2\n",
        "              INNER JOIN sap_dev.silver.dim_product dp2\n",
        "                ON fs2.ProductSK = dp2.ProductSK\n",
        "          GROUP BY\n",
        "            dp2.ProductName\n",
        "          ORDER BY\n",
        "            rev DESC\n",
        "          LIMIT 10\n",
        "        )\n",
        "    )\n",
        "),\n",
        "top_agents AS (\n",
        "  SELECT\n",
        "    SUM(fs.finalprice) AS top_agents_revenue\n",
        "  FROM\n",
        "    sap_dev.silver.fact_sales fs\n",
        "      INNER JOIN sap_dev.silver.dim_agent da\n",
        "        ON fs.AgentSK = da.AgentSK\n",
        "  WHERE\n",
        "    da.AgentName IN (\n",
        "      SELECT\n",
        "        AgentName\n",
        "      FROM\n",
        "        (\n",
        "          SELECT\n",
        "            da2.AgentName,\n",
        "            SUM(fs2.finalprice) AS rev\n",
        "          FROM\n",
        "            sap_dev.silver.fact_sales fs2\n",
        "              INNER JOIN sap_dev.silver.dim_agent da2\n",
        "                ON fs2.AgentSK = da2.AgentSK\n",
        "          GROUP BY\n",
        "            da2.AgentName\n",
        "          ORDER BY\n",
        "            rev DESC\n",
        "          LIMIT 10\n",
        "        )\n",
        "    )\n",
        ")\n",
        "SELECT\n",
        "  ROUND((tc.top_cities_revenue / tr.total) * 100, 1) AS top_10_cities_pct,\n",
        "  ROUND((tp.top_products_revenue / tr.total) * 100, 1) AS top_10_products_pct,\n",
        "  ROUND((ta.top_agents_revenue / tr.total) * 100, 1) AS top_10_agents_pct\n",
        "FROM\n",
        "  total_revenue tr CROSS JOIN top_cities tc CROSS JOIN top_products tp CROSS JOIN top_agents ta"
      ]
    },
    {
      "name": "top_cities_revenue",
      "displayName": "Top 10 Cities by Revenue",
      "queryLines": [
        "SELECT\n",
        "  da.AgentCity AS city,\n",
        "  SUM(fs.finalprice) AS revenue,\n",
        "  COUNT(DISTINCT fs.OrderID) AS orders\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales fs\n",
        "    INNER JOIN sap_dev.silver.dim_agent da\n",
        "      ON fs.AgentSK = da.AgentSK\n",
        "GROUP BY\n",
        "  da.AgentCity\n",
        "ORDER BY\n",
        "  revenue DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "performance_detail",
      "displayName": "Sales Performance Detail",
      "queryLines": [
        "SELECT\n",
        "  dd.Date AS date,\n",
        "  dp.ProductName AS product,\n",
        "  dpc.ProductCategory AS category,\n",
        "  da.AgentName AS agent,\n",
        "  da.AgentCity AS city,\n",
        "  COUNT(DISTINCT fs.OrderID) AS orders,\n",
        "  SUM(fs.ProductQuantity) AS units_sold,\n",
        "  SUM(fs.finalprice) AS revenue,\n",
        "  SUM(fs.finalprice) / NULLIF(COUNT(DISTINCT fs.OrderID), 0) AS aov\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales fs\n",
        "    INNER JOIN sap_dev.silver.dim_date dd\n",
        "      ON fs.OrderDateID = dd.DateID\n",
        "    INNER JOIN sap_dev.silver.dim_product dp\n",
        "      ON fs.ProductSK = dp.ProductSK\n",
        "    INNER JOIN sap_dev.silver.dim_product_category dpc\n",
        "      ON fs.ProductCategorySK = dpc.ProductCategorySK\n",
        "    INNER JOIN sap_dev.silver.dim_agent da\n",
        "      ON fs.AgentSK = da.AgentSK\n",
        "WHERE\n",
        "  dd.Date >= CURRENT_DATE() - INTERVAL 90 DAYS\n",
        "GROUP BY\n",
        "  dd.Date,\n",
        "  dp.ProductName,\n",
        "  dpc.ProductCategory,\n",
        "  da.AgentName,\n",
        "  da.AgentCity\n",
        "ORDER BY\n",
        "  dd.Date DESC,\n",
        "  revenue DESC"
      ]
    }
  ],
