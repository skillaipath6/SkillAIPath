{
  "datasets": [
    {
      "name": "product_recommendations",
      "displayName": "Product Recommendations",
      "config": {
        "version": "1.1",
        "source": "sap_dev.gold.product_recommendations",
        "dimensions": [
          {
            "name": "customer_id",
            "expr": "customer_id"
          },
          {
            "name": "recommended_product_id",
            "expr": "recommended_product_id"
          },
          {
            "name": "recommended_product_name",
            "expr": "recommended_product_name"
          },
          {
            "name": "recommendation_score",
            "expr": "recommendation_score"
          },
          {
            "name": "prediction_date",
            "expr": "prediction_date"
          },
          {
            "name": "recommendation_rank",
            "expr": "recommendation_rank"
          }
        ],
        "measures": [
          {
            "name": "total_customers",
            "expr": "COUNT(DISTINCT customer_id)"
          },
          {
            "name": "total_recommendations",
            "expr": "COUNT(*)"
          },
          {
            "name": "unique_products",
            "expr": "COUNT(DISTINCT recommended_product_id)"
          },
          {
            "name": "avg_recommendation_score",
            "expr": "AVG(recommendation_score)"
          },
          {
            "name": "total_score",
            "expr": "SUM(recommendation_score)"
          }
        ]
      }
    }
  ],
