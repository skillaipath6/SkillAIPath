{
  "datasets": [
    {
      "name": "churn_predictions",
      "displayName": "Churn Predictions",
      "config": {
        "version": "1.1",
        "source": "sap_dev.gold.churn_predictions",
        "dimensions": [
          {
            "name": "customer_id",
            "expr": "customer_id"
          },
          {
            "name": "prediction_date",
            "expr": "prediction_date"
          },
          {
            "name": "risk_segment",
            "expr": "risk_segment"
          },
          {
            "name": "model_version",
            "expr": "model_version"
          },
          {
            "name": "recency_days",
            "expr": "recency_days"
          },
          {
            "name": "total_purchases",
            "expr": "total_purchases"
          },
          {
            "name": "lifetime_value_lakhs",
            "expr": "lifetime_value_lakhs"
          },
          {
            "name": "churn_probability",
            "expr": "churn_probability"
          },
          {
            "name": "is_churned_predicted",
            "expr": "is_churned_predicted"
          },
          {
            "name": "probability_range",
            "expr": "CASE WHEN churn_probability < 0.1 THEN '0-10%' WHEN churn_probability < 0.2 THEN '10-20%' WHEN churn_probability < 0.3 THEN '20-30%' WHEN churn_probability < 0.4 THEN '30-40%' WHEN churn_probability < 0.5 THEN '40-50%' WHEN churn_probability < 0.6 THEN '50-60%' WHEN churn_probability < 0.7 THEN '60-70%' WHEN churn_probability < 0.8 THEN '70-80%' WHEN churn_probability < 0.9 THEN '80-90%' ELSE '90-100%' END"
          }
        ],
        "measures": [
          {
            "name": "total_customers",
            "expr": "COUNT(DISTINCT customer_id)"
          },
          {
            "name": "high_risk_customers",
            "expr": "COUNT(DISTINCT CASE WHEN risk_segment = 'High Risk' THEN customer_id END)"
          },
          {
            "name": "low_risk_customers",
            "expr": "COUNT(DISTINCT CASE WHEN risk_segment = 'Low Risk' THEN customer_id END)"
          },
          {
            "name": "medium_risk_customers",
            "expr": "COUNT(DISTINCT CASE WHEN risk_segment = 'Medium Risk' THEN customer_id END)"
          },
          {
            "name": "avg_churn_probability",
            "expr": "AVG(churn_probability)"
          },
          {
            "name": "total_lifetime_value",
            "expr": "SUM(lifetime_value_lakhs)"
          },
          {
            "name": "avg_recency_days",
            "expr": "AVG(recency_days)"
          },
          {
            "name": "total_purchase_count",
            "expr": "SUM(total_purchases)"
          }
        ]
      }
    },
    {
      "name": "top10_high_risk",
      "displayName": "Top 10 High Risk Customers",
      "queryLines": [
        "SELECT\n",
        "  customer_id,\n",
        "  churn_probability,\n",
        "  risk_segment\n",
        "FROM\n",
        "  sap_dev.gold.churn_predictions\n",
        "ORDER BY\n",
        "  churn_probability DESC\n",
        "LIMIT 10"
      ]
    }
  ],
