{
  "datasets": [
    {
      "name": "revenue_mtd",
      "displayName": "Revenue MTD",
      "queryLines": [
        "SELECT\n",
        "  SUM(finalprice * ProductQuantity) as mtd_revenue\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales\n",
        "WHERE\n",
        "  DATE_TRUNC('MONTH', BatchDate) = '2026-08-01'"
      ]
    },
    {
      "name": "order_trend",
      "displayName": "Order Volume Trend",
      "queryLines": [
        "SELECT\n",
        "  BatchDate as date,\n",
        "  COUNT(DISTINCT OrderID) as daily_orders\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales\n",
        "GROUP BY\n",
        "  BatchDate\n",
        "ORDER BY\n",
        "  BatchDate"
      ]
    },
    {
      "name": "revenue_ytd",
      "displayName": "Revenue YTD",
      "queryLines": [
        "SELECT\n",
        "  SUM(finalprice * ProductQuantity) as ytd_revenue\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales\n",
        "WHERE\n",
        "  YEAR(BatchDate) = 2026"
      ]
    },
    {
      "name": "order_volume",
      "displayName": "Order Volume",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT OrderID) as total_orders\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales"
      ]
    },
    {
      "name": "mom_growth",
      "displayName": "MoM Growth % — MTD vs Prior MTD",
      "queryLines": [
        "SELECT\n",
        "  ROUND(\n",
        "    (\n",
        "      (\n",
        "        SUM(\n",
        "          CASE\n",
        "            WHEN\n",
        "              BatchDate >= '2026-08-01'\n",
        "              AND BatchDate <= '2026-08-08'\n",
        "            THEN\n",
        "              finalprice * ProductQuantity\n",
        "            ELSE 0\n",
        "          END\n",
        "        )\n",
        "          - SUM(\n",
        "            CASE\n",
        "              WHEN\n",
        "                BatchDate >= '2026-07-09'\n",
        "                AND BatchDate <= '2026-07-16'\n",
        "              THEN\n",
        "                finalprice * ProductQuantity\n",
        "              ELSE 0\n",
        "            END\n",
        "          )\n",
        "      )\n",
        "        * 100.0\n",
        "        / NULLIF(\n",
        "          SUM(\n",
        "            CASE\n",
        "              WHEN\n",
        "                BatchDate >= '2026-07-09'\n",
        "                AND BatchDate <= '2026-07-16'\n",
        "              THEN\n",
        "                finalprice * ProductQuantity\n",
        "              ELSE 0\n",
        "            END\n",
        "          ),\n",
        "          0\n",
        "        )\n",
        "    ),\n",
        "    2\n",
        "  ) as mom_growth_pct\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales"
      ]
    },
    {
      "name": "active_customers",
      "displayName": "Customers with Sales",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT CustomerSK) as active_customers\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales"
      ]
    },
    {
      "name": "revenue_trend",
      "displayName": "Revenue Trend",
      "queryLines": [
        "SELECT\n",
        "  BatchDate as date,\n",
        "  SUM(finalprice * ProductQuantity) as daily_revenue\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales\n",
        "GROUP BY\n",
        "  BatchDate\n",
        "ORDER BY\n",
        "  BatchDate"
      ]
    },
    {
      "name": "wow_growth",
      "displayName": "WoW Growth",
      "queryLines": [
        "WITH week_data AS (\n",
        "  SELECT\n",
        "    CASE\n",
        "      WHEN\n",
        "        BatchDate >= '2026-07-27'\n",
        "        AND BatchDate < '2026-08-03'\n",
        "      THEN\n",
        "        'current_week'\n",
        "      WHEN\n",
        "        BatchDate >= '2026-07-20'\n",
        "        AND BatchDate < '2026-07-27'\n",
        "      THEN\n",
        "        'prior_week'\n",
        "    END as week_label,\n",
        "    SUM(finalprice * ProductQuantity) as week_revenue\n",
        "  FROM\n",
        "    sap_dev.silver.fact_sales\n",
        "  WHERE\n",
        "    BatchDate >= '2026-07-20'\n",
        "    AND BatchDate < '2026-08-03'\n",
        "  GROUP BY\n",
        "    week_label\n",
        ")\n",
        "SELECT\n",
        "  (\n",
        "    (\n",
        "      MAX(\n",
        "        CASE\n",
        "          WHEN week_label = 'current_week' THEN week_revenue\n",
        "        END\n",
        "      )\n",
        "        - MAX(\n",
        "          CASE\n",
        "            WHEN week_label = 'prior_week' THEN week_revenue\n",
        "          END\n",
        "        )\n",
        "    )\n",
        "      / MAX(\n",
        "        CASE\n",
        "          WHEN week_label = 'prior_week' THEN week_revenue\n",
        "        END\n",
        "      )\n",
        "      * 100\n",
        "  ) as wow_growth_pct\n",
        "FROM\n",
        "  week_data"
      ]
    },
    {
      "name": "gross_margin",
      "displayName": "Gross Margin",
      "queryLines": [
        "SELECT\n",
        "  (\n",
        "    (SUM(finalprice * ProductQuantity) - SUM(CostPrice * ProductQuantity))\n",
        "      / SUM(finalprice * ProductQuantity)\n",
        "      * 100\n",
        "  ) as margin_pct\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales"
      ]
    },
    {
      "name": "top_categories",
      "displayName": "Top Product Categories",
      "queryLines": [
        "SELECT\n",
        "  p.ProductCategory,\n",
        "  SUM(f.finalprice * f.ProductQuantity) as category_revenue\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales f\n",
        "    JOIN sap_dev.gold.mart_product_performance p\n",
        "      ON f.ProductSK = p.ProductSK\n",
        "GROUP BY\n",
        "  p.ProductCategory\n",
        "ORDER BY\n",
        "  category_revenue DESC\n",
        "LIMIT 8"
      ]
    },
    {
      "name": "executive_summary",
      "displayName": "Executive Summary",
      "queryLines": [
        "WITH metrics AS (\n",
        "  SELECT\n",
        "    SUM(finalprice * ProductQuantity) as total_revenue,\n",
        "    SUM(CostPrice * ProductQuantity) as total_cost,\n",
        "    COUNT(DISTINCT OrderID) as total_orders,\n",
        "    COUNT(DISTINCT CustomerSK) as active_customers\n",
        "  FROM\n",
        "    sap_dev.silver.fact_sales\n",
        "),\n",
        "top_cat AS (\n",
        "  SELECT\n",
        "    p.ProductCategory\n",
        "  FROM\n",
        "    sap_dev.silver.fact_sales f\n",
        "      JOIN sap_dev.gold.mart_product_performance p\n",
        "        ON f.ProductSK = p.ProductSK\n",
        "  GROUP BY\n",
        "    p.ProductCategory\n",
        "  ORDER BY\n",
        "    SUM(f.finalprice * f.ProductQuantity) DESC\n",
        "  LIMIT 1\n",
        ")\n",
        "SELECT\n",
        "  'Total Revenue' as metric_name,\n",
        "  CAST(m.total_revenue AS STRING) as metric_value\n",
        "FROM\n",
        "  metrics m\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Total Orders',\n",
        "  CAST(m.total_orders AS STRING)\n",
        "FROM\n",
        "  metrics m\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Active Customers',\n",
        "  CAST(m.active_customers AS STRING)\n",
        "FROM\n",
        "  metrics m\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Avg Order Value',\n",
        "  CAST(m.total_revenue / m.total_orders AS STRING)\n",
        "FROM\n",
        "  metrics m\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Gross Margin %',\n",
        "  CAST(((m.total_revenue - m.total_cost) / m.total_revenue * 100) AS STRING)\n",
        "FROM\n",
        "  metrics m\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Top Category',\n",
        "  t.ProductCategory\n",
        "FROM\n",
        "  top_cat t"
      ]
    },
    {
      "name": "date_range_check",
      "displayName": "Date Range Check",
      "queryLines": [
        "SELECT\n",
        "  MIN(BatchDate) as min_date,\n",
        "  MAX(BatchDate) as max_date,\n",
        "  COUNT(DISTINCT BatchDate) as distinct_days,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN DATE_TRUNC('MONTH', BatchDate) = '2026-07-01' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as july_rows,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN DATE_TRUNC('MONTH', BatchDate) = '2026-08-01' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as august_rows,\n",
        "  MAX(\n",
        "    CASE\n",
        "      WHEN DATE_TRUNC('MONTH', BatchDate) = '2026-08-01' THEN BatchDate\n",
        "    END\n",
        "  ) as max_august_date\n",
        "FROM\n",
        "  sap_dev.silver.fact_sales"
      ]
    }
  ],
