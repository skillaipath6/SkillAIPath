{
  "datasets": [
    {
      "name": "revenue_mtd",
      "displayName": "Revenue MTD",
      "queryLines": [
        "SELECT\n",
        "  SUM(finalprice * ProductQuantity) as mtd_revenue\n",
        "FROM\n",
        "  sap_main.silver.fact_sales\n",
        "WHERE\n",
        "  DATE_TRUNC('MONTH', BatchDate)\n",
        "    = DATE_TRUNC(\n",
        "      'MONTH',\n",
        "      (\n",
        "        SELECT\n",
        "          MAX(BatchDate)\n",
        "        FROM\n",
        "          sap_main.silver.fact_sales\n",
        "      )\n",
        "    )"
      ]
    },
    {
      "name": "order_trend",
      "displayName": "Order Volume Trend",
      "queryLines": [
        "SELECT\n",
        "  BatchDate as date,\n",
        "  COUNT(DISTINCT OrderID) as daily_orders\n",
        "FROM\n",
        "  sap_main.silver.fact_sales\n",
        "GROUP BY\n",
        "  BatchDate\n",
        "ORDER BY\n",
        "  BatchDate"
      ]
    },
    {
      "name": "revenue_ytd",
      "displayName": "Revenue YTD",
      "queryLines": [
        "SELECT\n",
        "  SUM(finalprice * ProductQuantity) as ytd_revenue\n",
        "FROM\n",
        "  sap_main.silver.fact_sales\n",
        "WHERE\n",
        "  BatchDate\n",
        "    >= DATE_TRUNC(\n",
        "      'YEAR',\n",
        "      (\n",
        "        SELECT\n",
        "          MAX(BatchDate)\n",
        "        FROM\n",
        "          sap_main.silver.fact_sales\n",
        "      )\n",
        "    )"
      ]
    },
    {
      "name": "order_volume",
      "displayName": "Order Volume",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT OrderID) as total_orders\n",
        "FROM\n",
        "  sap_main.silver.fact_sales"
      ]
    },
    {
      "name": "mom_growth",
      "displayName": "MoM Growth % — MTD vs Prior MTD (dynamic)",
      "queryLines": [
        "WITH params AS (\n",
        "  SELECT\n",
        "    DATE_TRUNC('MONTH', MAX(BatchDate)) as current_month,\n",
        "    MAX(BatchDate) as max_date\n",
        "  FROM\n",
        "    sap_main.silver.fact_sales\n",
        "),\n",
        "current_mtd AS (\n",
        "  SELECT\n",
        "    SUM(finalprice * ProductQuantity) as revenue\n",
        "  FROM\n",
        "    sap_main.silver.fact_sales f CROSS JOIN params p\n",
        "  WHERE\n",
        "    DATE_TRUNC('MONTH', f.BatchDate) = p.current_month\n",
        "),\n",
        "prior_mtd AS (\n",
        "  SELECT\n",
        "    SUM(finalprice * ProductQuantity) as revenue\n",
        "  FROM\n",
        "    sap_main.silver.fact_sales f CROSS JOIN params p\n",
        "  WHERE\n",
        "    DATE_TRUNC('MONTH', f.BatchDate) = p.current_month - INTERVAL 1 MONTH\n",
        "    AND DAY(f.BatchDate) <= DAY(p.max_date)\n",
        "),\n",
        "day_revenue AS (\n",
        "  SELECT\n",
        "    BatchDate as day,\n",
        "    SUM(finalprice * ProductQuantity) as revenue\n",
        "  FROM\n",
        "    sap_main.silver.fact_sales\n",
        "  GROUP BY\n",
        "    BatchDate\n",
        "),\n",
        "ranked AS (\n",
        "  SELECT\n",
        "    revenue,\n",
        "    DENSE_RANK() OVER (ORDER BY day DESC) as recency_rank\n",
        "  FROM\n",
        "    day_revenue\n",
        "),\n",
        "fb_params AS (\n",
        "  SELECT\n",
        "    LEAST(30, FLOOR(COUNT(*) / 2)) as window_days\n",
        "  FROM\n",
        "    ranked\n",
        "),\n",
        "fb_windows AS (\n",
        "  SELECT\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN recency_rank <= p.window_days THEN r.revenue\n",
        "      END\n",
        "    ) as fallback_current,\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN\n",
        "          recency_rank > p.window_days\n",
        "          AND recency_rank <= 2 * p.window_days\n",
        "        THEN\n",
        "          r.revenue\n",
        "      END\n",
        "    ) as fallback_prior\n",
        "  FROM\n",
        "    ranked r CROSS JOIN fb_params p\n",
        ")\n",
        "SELECT\n",
        "  CASE\n",
        "    WHEN\n",
        "      COALESCE(\n",
        "        (\n",
        "          SELECT\n",
        "            revenue\n",
        "          FROM\n",
        "            prior_mtd\n",
        "        ),\n",
        "        0\n",
        "      ) <> 0\n",
        "    THEN\n",
        "      ROUND(\n",
        "        (\n",
        "          (\n",
        "            SELECT\n",
        "              revenue\n",
        "            FROM\n",
        "              current_mtd\n",
        "          )\n",
        "            - (\n",
        "              SELECT\n",
        "                revenue\n",
        "              FROM\n",
        "                prior_mtd\n",
        "            )\n",
        "        )\n",
        "          * 100.0\n",
        "          / (\n",
        "            SELECT\n",
        "              revenue\n",
        "            FROM\n",
        "              prior_mtd\n",
        "          ),\n",
        "        2\n",
        "      )\n",
        "    WHEN\n",
        "      (\n",
        "        SELECT\n",
        "          window_days\n",
        "        FROM\n",
        "          fb_params\n",
        "      ) >= 2\n",
        "      AND COALESCE(\n",
        "        (\n",
        "          SELECT\n",
        "            fallback_prior\n",
        "          FROM\n",
        "            fb_windows\n",
        "        ),\n",
        "        0\n",
        "      ) <> 0\n",
        "    THEN\n",
        "      ROUND(\n",
        "        (\n",
        "          (\n",
        "            SELECT\n",
        "              fallback_current\n",
        "            FROM\n",
        "              fb_windows\n",
        "          )\n",
        "            - (\n",
        "              SELECT\n",
        "                fallback_prior\n",
        "              FROM\n",
        "                fb_windows\n",
        "            )\n",
        "        )\n",
        "          * 100.0\n",
        "          / (\n",
        "            SELECT\n",
        "              fallback_prior\n",
        "            FROM\n",
        "              fb_windows\n",
        "          ),\n",
        "        2\n",
        "      )\n",
        "    ELSE NULL\n",
        "  END as mom_growth_pct"
      ]
    },
    {
      "name": "active_customers",
      "displayName": "Customers with Sales",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT CustomerSK) as active_customers\n",
        "FROM\n",
        "  sap_main.silver.fact_sales"
      ]
    },
    {
      "name": "revenue_trend",
      "displayName": "Revenue Trend",
      "queryLines": [
        "SELECT\n",
        "  BatchDate as date,\n",
        "  SUM(finalprice * ProductQuantity) as daily_revenue\n",
        "FROM\n",
        "  sap_main.silver.fact_sales\n",
        "GROUP BY\n",
        "  BatchDate\n",
        "ORDER BY\n",
        "  BatchDate"
      ]
    },
    {
      "name": "wow_growth",
      "displayName": "WoW Growth (dynamic)",
      "queryLines": [
        "WITH day_revenue AS (\n",
        "  SELECT\n",
        "    BatchDate as day,\n",
        "    SUM(finalprice * ProductQuantity) as revenue\n",
        "  FROM\n",
        "    sap_main.silver.fact_sales\n",
        "  GROUP BY\n",
        "    BatchDate\n",
        "),\n",
        "ranked AS (\n",
        "  SELECT\n",
        "    revenue,\n",
        "    DENSE_RANK() OVER (ORDER BY day DESC) as recency_rank\n",
        "  FROM\n",
        "    day_revenue\n",
        "),\n",
        "params AS (\n",
        "  SELECT\n",
        "    LEAST(7, FLOOR(COUNT(*) / 2)) as window_days\n",
        "  FROM\n",
        "    ranked\n",
        "),\n",
        "windows AS (\n",
        "  SELECT\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN recency_rank <= p.window_days THEN r.revenue\n",
        "      END\n",
        "    ) as current_revenue,\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN\n",
        "          recency_rank > p.window_days\n",
        "          AND recency_rank <= 2 * p.window_days\n",
        "        THEN\n",
        "          r.revenue\n",
        "      END\n",
        "    ) as prior_revenue\n",
        "  FROM\n",
        "    ranked r CROSS JOIN params p\n",
        ")\n",
        "SELECT\n",
        "  CASE\n",
        "    WHEN\n",
        "      (\n",
        "        SELECT\n",
        "          window_days\n",
        "        FROM\n",
        "          params\n",
        "      ) < 2\n",
        "      OR COALESCE(\n",
        "        (\n",
        "          SELECT\n",
        "            prior_revenue\n",
        "          FROM\n",
        "            windows\n",
        "        ),\n",
        "        0\n",
        "      ) = 0\n",
        "    THEN\n",
        "      NULL\n",
        "    ELSE\n",
        "      ROUND(\n",
        "        (\n",
        "          (\n",
        "            SELECT\n",
        "              current_revenue\n",
        "            FROM\n",
        "              windows\n",
        "          )\n",
        "            - (\n",
        "              SELECT\n",
        "                prior_revenue\n",
        "              FROM\n",
        "                windows\n",
        "            )\n",
        "        )\n",
        "          * 100.0\n",
        "          / (\n",
        "            SELECT\n",
        "              prior_revenue\n",
        "            FROM\n",
        "              windows\n",
        "          ),\n",
        "        2\n",
        "      )\n",
        "  END as wow_growth_pct"
      ]
    },
    {
      "name": "gross_margin",
      "displayName": "Gross Margin",
      "queryLines": [
        "SELECT\n",
        "  (\n",
        "    (SUM(finalprice * ProductQuantity) - SUM(CostPrice * ProductQuantity))\n",
        "      / SUM(finalprice * ProductQuantity)\n",
        "      * 100\n",
        "  ) as margin_pct\n",
        "FROM\n",
        "  sap_main.silver.fact_sales"
      ]
    },
    {
      "name": "top_categories",
      "displayName": "Top Product Categories",
      "queryLines": [
        "SELECT\n",
        "  p.ProductCategory,\n",
        "  SUM(f.finalprice * f.ProductQuantity) as category_revenue\n",
        "FROM\n",
        "  sap_main.silver.fact_sales f\n",
        "    JOIN sap_main.gold.mart_product_performance p\n",
        "      ON f.ProductSK = p.ProductSK\n",
        "GROUP BY\n",
        "  p.ProductCategory\n",
        "ORDER BY\n",
        "  category_revenue DESC\n",
        "LIMIT 8"
      ]
    },
    {
      "name": "executive_summary",
      "displayName": "Executive Summary",
      "queryLines": [
        "WITH metrics AS (\n",
        "  SELECT\n",
        "    SUM(finalprice * ProductQuantity) as total_revenue,\n",
        "    SUM(CostPrice * ProductQuantity) as total_cost,\n",
        "    COUNT(DISTINCT OrderID) as total_orders,\n",
        "    COUNT(DISTINCT CustomerSK) as active_customers\n",
        "  FROM\n",
        "    sap_main.silver.fact_sales\n",
        "),\n",
        "top_cat AS (\n",
        "  SELECT\n",
        "    p.ProductCategory\n",
        "  FROM\n",
        "    sap_main.silver.fact_sales f\n",
        "      JOIN sap_main.gold.mart_product_performance p\n",
        "        ON f.ProductSK = p.ProductSK\n",
        "  GROUP BY\n",
        "    p.ProductCategory\n",
        "  ORDER BY\n",
        "    SUM(f.finalprice * ProductQuantity) DESC\n",
        "  LIMIT 1\n",
        ")\n",
        "SELECT\n",
        "  'Total Revenue' as metric_name,\n",
        "  CAST(m.total_revenue AS STRING) as metric_value\n",
        "FROM\n",
        "  metrics m\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Total Orders',\n",
        "  CAST(m.total_orders AS STRING)\n",
        "FROM\n",
        "  metrics m\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Active Customers',\n",
        "  CAST(m.active_customers AS STRING)\n",
        "FROM\n",
        "  metrics m\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Avg Order Value',\n",
        "  CAST(m.total_revenue / m.total_orders AS STRING)\n",
        "FROM\n",
        "  metrics m\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Gross Margin %',\n",
        "  CAST(((m.total_revenue - m.total_cost) / m.total_revenue * 100) AS STRING)\n",
        "FROM\n",
        "  metrics m\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Top Category',\n",
        "  t.ProductCategory\n",
        "FROM\n",
        "  top_cat t"
      ]
    },
    {
      "name": "date_range_check",
      "displayName": "Date Range Check",
      "queryLines": [
        "SELECT\n",
        "  MIN(BatchDate) as min_date,\n",
        "  MAX(BatchDate) as max_date,\n",
        "  COUNT(DISTINCT BatchDate) as distinct_days,\n",
        "  COUNT(*) as total_rows,\n",
        "  DATE_TRUNC('MONTH', MAX(BatchDate)) as latest_batch_month\n",
        "FROM\n",
        "  sap_main.silver.fact_sales"
      ]
    }
  ],
