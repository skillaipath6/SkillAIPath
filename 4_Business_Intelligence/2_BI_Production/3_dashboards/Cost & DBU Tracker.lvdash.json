{
  "datasets": [
    {
      "name": "kpi_metrics",
      "displayName": "KPI Summary Metrics",
      "queryLines": [
        "-- MTD DBU usage and estimated costs\n",
        "-- Note: Costs are ESTIMATES based on reference pricing\n",
        "SELECT\n",
        "  SUM(usage_quantity) as total_dbus_mtd,\n",
        "  SUM(\n",
        "    usage_quantity\n",
        "      * CASE\n",
        "        WHEN sku_name LIKE '%ALL_PURPOSE%' THEN 0.55\n",
        "        WHEN sku_name LIKE '%JOBS%' THEN 0.15\n",
        "        WHEN sku_name LIKE '%SQL%' THEN 0.22\n",
        "        WHEN sku_name LIKE '%DLT%' THEN 0.30\n",
        "        ELSE 0.20\n",
        "      END\n",
        "  ) as total_cost_mtd,\n",
        "  SUM(\n",
        "    usage_quantity\n",
        "      * CASE\n",
        "        WHEN sku_name LIKE '%ALL_PURPOSE%' THEN 0.55\n",
        "        WHEN sku_name LIKE '%JOBS%' THEN 0.15\n",
        "        WHEN sku_name LIKE '%SQL%' THEN 0.22\n",
        "        WHEN sku_name LIKE '%DLT%' THEN 0.30\n",
        "        ELSE 0.20\n",
        "      END\n",
        "  )\n",
        "    / DAY(CURRENT_DATE()) as avg_daily_cost,\n",
        "  6000.0 as monthly_budget,\n",
        "  6000.0\n",
        "    - SUM(\n",
        "      usage_quantity\n",
        "        * CASE\n",
        "          WHEN sku_name LIKE '%ALL_PURPOSE%' THEN 0.55\n",
        "          WHEN sku_name LIKE '%JOBS%' THEN 0.15\n",
        "          WHEN sku_name LIKE '%SQL%' THEN 0.22\n",
        "          WHEN sku_name LIKE '%DLT%' THEN 0.30\n",
        "          ELSE 0.20\n",
        "        END\n",
        "    ) as budget_remaining,\n",
        "  SUM(\n",
        "    usage_quantity\n",
        "      * CASE\n",
        "        WHEN sku_name LIKE '%ALL_PURPOSE%' THEN 0.55\n",
        "        WHEN sku_name LIKE '%JOBS%' THEN 0.15\n",
        "        WHEN sku_name LIKE '%SQL%' THEN 0.22\n",
        "        WHEN sku_name LIKE '%DLT%' THEN 0.30\n",
        "        ELSE 0.20\n",
        "      END\n",
        "  )\n",
        "    / 6000.0 as budget_utilization_pct\n",
        "FROM\n",
        "  system.billing.usage\n",
        "WHERE\n",
        "  usage_date >= DATE_TRUNC('MONTH', CURRENT_DATE())\n",
        "  AND usage_date <= CURRENT_DATE()\n",
        "  AND usage_unit = 'DBU'"
      ]
    },
    {
      "name": "cost_by_compute_type",
      "displayName": "Cost by Compute Type",
      "queryLines": [
        "-- MTD cost breakdown by compute type\n",
        "SELECT\n",
        "  CASE\n",
        "    WHEN sku_name LIKE '%ALL_PURPOSE%' THEN 'All-Purpose Compute'\n",
        "    WHEN sku_name LIKE '%JOBS%' THEN 'Jobs Compute'\n",
        "    WHEN sku_name LIKE '%SQL%' THEN 'SQL Compute'\n",
        "    WHEN sku_name LIKE '%DLT%' THEN 'DLT Compute'\n",
        "    ELSE 'Other Compute'\n",
        "  END as compute_type,\n",
        "  SUM(usage_quantity) as total_dbus,\n",
        "  SUM(\n",
        "    usage_quantity\n",
        "      * CASE\n",
        "        WHEN sku_name LIKE '%ALL_PURPOSE%' THEN 0.55\n",
        "        WHEN sku_name LIKE '%JOBS%' THEN 0.15\n",
        "        WHEN sku_name LIKE '%SQL%' THEN 0.22\n",
        "        WHEN sku_name LIKE '%DLT%' THEN 0.30\n",
        "        ELSE 0.20\n",
        "      END\n",
        "  ) as cost_usd\n",
        "FROM\n",
        "  system.billing.usage\n",
        "WHERE\n",
        "  usage_date >= DATE_TRUNC('MONTH', CURRENT_DATE())\n",
        "  AND usage_date <= CURRENT_DATE()\n",
        "  AND usage_unit = 'DBU'\n",
        "GROUP BY\n",
        "  compute_type\n",
        "ORDER BY\n",
        "  cost_usd DESC"
      ]
    },
    {
      "name": "daily_cost_summary",
      "displayName": "Daily Cost Summary",
      "queryLines": [
        "-- Daily breakdown for MTD period\n",
        "SELECT\n",
        "  usage_date,\n",
        "  SUM(usage_quantity) as total_dbus,\n",
        "  SUM(\n",
        "    usage_quantity\n",
        "      * CASE\n",
        "        WHEN sku_name LIKE '%ALL_PURPOSE%' THEN 0.55\n",
        "        WHEN sku_name LIKE '%JOBS%' THEN 0.15\n",
        "        WHEN sku_name LIKE '%SQL%' THEN 0.22\n",
        "        WHEN sku_name LIKE '%DLT%' THEN 0.30\n",
        "        ELSE 0.20\n",
        "      END\n",
        "  ) as cost_usd\n",
        "FROM\n",
        "  system.billing.usage\n",
        "WHERE\n",
        "  usage_date >= DATE_TRUNC('MONTH', CURRENT_DATE())\n",
        "  AND usage_date <= CURRENT_DATE()\n",
        "  AND usage_unit = 'DBU'\n",
        "GROUP BY\n",
        "  usage_date\n",
        "ORDER BY\n",
        "  usage_date"
      ]
    },
    {
      "name": "cost_by_job",
      "displayName": "Cost by Job",
      "queryLines": [
        "-- MTD cost by job\n",
        "SELECT\n",
        "  COALESCE(usage_metadata.job_name, 'Unnamed Job') as job_name,\n",
        "  usage_metadata.job_id,\n",
        "  SUM(usage_quantity) as total_dbus,\n",
        "  SUM(\n",
        "    usage_quantity\n",
        "      * CASE\n",
        "        WHEN sku_name LIKE '%ALL_PURPOSE%' THEN 0.55\n",
        "        WHEN sku_name LIKE '%JOBS%' THEN 0.15\n",
        "        WHEN sku_name LIKE '%SQL%' THEN 0.22\n",
        "        WHEN sku_name LIKE '%DLT%' THEN 0.30\n",
        "        ELSE 0.20\n",
        "      END\n",
        "  ) as cost_usd,\n",
        "  COUNT(DISTINCT usage_metadata.job_run_id) as run_count\n",
        "FROM\n",
        "  system.billing.usage\n",
        "WHERE\n",
        "  usage_date >= DATE_TRUNC('MONTH', CURRENT_DATE())\n",
        "  AND usage_date <= CURRENT_DATE()\n",
        "  AND usage_unit = 'DBU'\n",
        "  AND usage_metadata.job_id IS NOT NULL\n",
        "GROUP BY\n",
        "  job_name,\n",
        "  usage_metadata.job_id\n",
        "ORDER BY\n",
        "  cost_usd DESC"
      ]
    },
    {
      "name": "top_10_expensive_jobs",
      "displayName": "Top 10 Expensive Jobs",
      "queryLines": [
        "-- Top 10 most expensive jobs MTD\n",
        "SELECT\n",
        "  COALESCE(usage_metadata.job_name, 'Unnamed Job') as job_name,\n",
        "  SUM(usage_quantity) as total_dbus,\n",
        "  SUM(\n",
        "    usage_quantity\n",
        "      * CASE\n",
        "        WHEN sku_name LIKE '%ALL_PURPOSE%' THEN 0.55\n",
        "        WHEN sku_name LIKE '%JOBS%' THEN 0.15\n",
        "        WHEN sku_name LIKE '%SQL%' THEN 0.22\n",
        "        WHEN sku_name LIKE '%DLT%' THEN 0.30\n",
        "        ELSE 0.20\n",
        "      END\n",
        "  ) as cost_usd,\n",
        "  COUNT(DISTINCT usage_metadata.job_run_id) as run_count\n",
        "FROM\n",
        "  system.billing.usage\n",
        "WHERE\n",
        "  usage_date >= DATE_TRUNC('MONTH', CURRENT_DATE())\n",
        "  AND usage_date <= CURRENT_DATE()\n",
        "  AND usage_unit = 'DBU'\n",
        "  AND usage_metadata.job_id IS NOT NULL\n",
        "GROUP BY\n",
        "  job_name\n",
        "ORDER BY\n",
        "  cost_usd DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "dbu_consumption_trend",
      "displayName": "DBU Consumption Trend",
      "queryLines": [
        "-- Daily DBU consumption MTD\n",
        "SELECT\n",
        "  usage_date,\n",
        "  SUM(usage_quantity) as total_dbus\n",
        "FROM\n",
        "  system.billing.usage\n",
        "WHERE\n",
        "  usage_date >= DATE_TRUNC('MONTH', CURRENT_DATE())\n",
        "  AND usage_date <= CURRENT_DATE()\n",
        "  AND usage_unit = 'DBU'\n",
        "GROUP BY\n",
        "  usage_date\n",
        "ORDER BY\n",
        "  usage_date"
      ]
    }
  ],
