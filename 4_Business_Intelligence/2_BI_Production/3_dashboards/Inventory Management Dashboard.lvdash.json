{
  "datasets": [
    {
      "name": "low_stock_items",
      "displayName": "Inventory Risk — Low & Out of Stock Items",
      "queryLines": [
        "SELECT\n",
        "  p.ProductName,\n",
        "  w.WareHouseName,\n",
        "  w.WareHouseCity,\n",
        "  f.StockQuantity,\n",
        "  f.StockValue,\n",
        "  f.StockStatus\n",
        "FROM\n",
        "  sap_dev.silver.fact_inventory f\n",
        "    INNER JOIN sap_dev.silver.dim_warehouse w\n",
        "      ON f.WarehouseSK = w.WareHouseSK\n",
        "    INNER JOIN sap_dev.silver.dim_product p\n",
        "      ON f.ProductSK = p.ProductSK\n",
        "WHERE\n",
        "  (\n",
        "    f.StockQuantity > 0\n",
        "    AND f.StockQuantity < 10\n",
        "  )\n",
        "  OR f.StockQuantity = 0\n",
        "ORDER BY\n",
        "  CASE\n",
        "    WHEN f.StockStatus = 'Out of Stock' THEN 0\n",
        "    WHEN f.StockStatus = 'Low Stock' THEN 1\n",
        "    ELSE 2\n",
        "  END,\n",
        "  f.StockQuantity ASC,\n",
        "  f.StockValue DESC"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "warehouse_inventory_risk",
      "displayName": "Warehouse Inventory Risk",
      "queryLines": [
        "SELECT\n",
        "  w.WareHouseName,\n",
        "  w.WareHouseCity,\n",
        "  SUM(f.StockQuantity) as TotalStock,\n",
        "  SUM(f.StockValue) as InventoryValue,\n",
        "  COUNT(\n",
        "    CASE\n",
        "      WHEN\n",
        "        f.StockQuantity > 0\n",
        "        AND f.StockQuantity < 10\n",
        "      THEN\n",
        "        1\n",
        "    END\n",
        "  ) as LowStockItems,\n",
        "  COUNT(\n",
        "    CASE\n",
        "      WHEN f.StockQuantity = 0 THEN 1\n",
        "    END\n",
        "  ) as OutOfStockItems\n",
        "FROM\n",
        "  sap_dev.silver.fact_inventory f\n",
        "    INNER JOIN sap_dev.silver.dim_warehouse w\n",
        "      ON f.WarehouseSK = w.WareHouseSK\n",
        "GROUP BY\n",
        "  w.WareHouseName,\n",
        "  w.WareHouseCity\n",
        "ORDER BY\n",
        "  OutOfStockItems DESC,\n",
        "  LowStockItems DESC"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "top_warehouses_by_value",
      "displayName": "Top 10 Warehouses by Inventory Value",
      "queryLines": [
        "SELECT\n",
        "  w.WareHouseName,\n",
        "  SUM(f.StockValue) as TotalInventoryValue\n",
        "FROM\n",
        "  sap_dev.silver.fact_inventory f\n",
        "    INNER JOIN sap_dev.silver.dim_warehouse w\n",
        "      ON f.WarehouseSK = w.WareHouseSK\n",
        "GROUP BY\n",
        "  w.WareHouseName\n",
        "ORDER BY\n",
        "  TotalInventoryValue DESC\n",
        "LIMIT 10"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "inventory_kpis",
      "displayName": "Inventory KPIs",
      "queryLines": [
        "SELECT\n",
        "  SUM(StockQuantity) as TotalStockQuantity,\n",
        "  SUM(StockValue) as TotalInventoryValue,\n",
        "  COUNT(\n",
        "    CASE\n",
        "      WHEN\n",
        "        StockQuantity > 0\n",
        "        AND StockQuantity < 10\n",
        "      THEN\n",
        "        1\n",
        "    END\n",
        "  ) as LowStockItems,\n",
        "  COUNT(\n",
        "    CASE\n",
        "      WHEN StockQuantity = 0 THEN 1\n",
        "    END\n",
        "  ) as OutOfStockItems,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        StockQuantity > 0\n",
        "        AND StockQuantity < 10\n",
        "      THEN\n",
        "        StockValue\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as LowStockInventoryValue,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN StockQuantity = 0 THEN StockValue\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) as OutOfStockInventoryValue\n",
        "FROM\n",
        "  sap_dev.silver.fact_inventory"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "top_warehouses_by_quantity",
      "displayName": "Top 10 Warehouses by Stock Quantity",
      "queryLines": [
        "SELECT\n",
        "  w.WareHouseName,\n",
        "  SUM(f.StockQuantity) as TotalStockQuantity\n",
        "FROM\n",
        "  sap_dev.silver.fact_inventory f\n",
        "    INNER JOIN sap_dev.silver.dim_warehouse w\n",
        "      ON f.WarehouseSK = w.WareHouseSK\n",
        "GROUP BY\n",
        "  w.WareHouseName\n",
        "ORDER BY\n",
        "  TotalStockQuantity DESC\n",
        "LIMIT 10"
      ],
      "catalog": "sap_dev",
      "schema": "silver"
    },
    {
      "name": "warehouse_critical_risk",
      "displayName": "Warehouses with Critical Risk",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT w.WareHouseName) as WarehousesWithOutOfStock\n",
        "FROM\n",
        "  sap_dev.silver.fact_inventory f\n",
        "    INNER JOIN sap_dev.silver.dim_warehouse w\n",
        "      ON f.WarehouseSK = w.WareHouseSK\n",
        "WHERE\n",
        "  f.StockQuantity = 0"
      ]
    }
  ],
