{
  "datasets": [
    {
      "name": "demand_forecasting_dashboard",
      "displayName": "Demand Forecasting Dashboard",
      "config": {
        "version": "1.1",
        "source": "sap_dev.gold.demand_forecast",
        "dimensions": [
          {
            "name": "product_name",
            "expr": "product_name"
          },
          {
            "name": "category",
            "expr": "category"
          },
          {
            "name": "forecast_date",
            "expr": "forecast_date"
          },
          {
            "name": "prediction_date",
            "expr": "prediction_date"
          },
          {
            "name": "model_type",
            "expr": "model_type"
          },
          {
            "name": "forecast_horizon_days",
            "expr": "forecast_horizon_days"
          }
        ],
        "measures": [
          {
            "name": "total_products",
            "expr": "COUNT(DISTINCT product_id)"
          },
          {
            "name": "avg_predicted_demand",
            "expr": "AVG(predicted_demand)"
          },
          {
            "name": "sum_predicted_demand",
            "expr": "SUM(predicted_demand)"
          },
          {
            "name": "avg_lower_bound",
            "expr": "AVG(lower_bound)"
          },
          {
            "name": "avg_upper_bound",
            "expr": "AVG(upper_bound)"
          },
          {
            "name": "negative_demand_count",
            "expr": "COUNT(CASE WHEN predicted_demand < 0 THEN 1 END)"
          },
          {
            "name": "total_forecasts",
            "expr": "COUNT(*)"
          },
          {
            "name": "min_forecast_date",
            "expr": "MIN(forecast_date)"
          },
          {
            "name": "max_forecast_date",
            "expr": "MAX(forecast_date)"
          }
        ]
      }
    }
  ],
