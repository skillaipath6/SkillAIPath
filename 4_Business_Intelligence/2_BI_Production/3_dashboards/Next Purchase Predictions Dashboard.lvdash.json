{
  "datasets": [
    {
      "name": "next_purchase_predictions",
      "displayName": "Next Purchase Predictions",
      "config": {
        "version": "1.1",
        "source": "sap_dev.gold.next_purchase_predictions",
        "dimensions": [
          {
            "name": "customer_id",
            "expr": "customer_id"
          },
          {
            "name": "recommended_product_id",
            "expr": "recommended_product_id"
          },
          {
            "name": "recommended_product_name",
            "expr": "recommended_product_name"
          },
          {
            "name": "recommendation_rank",
            "expr": "recommendation_rank"
          },
          {
            "name": "recommendation_score",
            "expr": "recommendation_score"
          },
          {
            "name": "prediction_date",
            "expr": "prediction_date"
          }
        ],
        "measures": [
          {
            "name": "total_customers",
            "expr": "COUNT(DISTINCT customer_id)"
          },
          {
            "name": "total_predictions",
            "expr": "COUNT(*)"
          },
          {
            "name": "unique_products",
            "expr": "COUNT(DISTINCT recommended_product_id)"
          },
          {
            "name": "avg_recommendations_per_customer",
            "expr": "COUNT(*) * 1.0 / COUNT(DISTINCT customer_id)"
          },
          {
            "name": "prediction_frequency",
            "expr": "COUNT(recommended_product_id)"
          },
          {
            "name": "avg_score",
            "expr": "AVG(recommendation_score)"
          }
        ]
      }
    },
    {
      "name": "rank1_products",
      "displayName": "Top Products by Rank-1 Recommendations",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  recommended_product_name,\n  COUNT(*) AS rank1_count\nFROM sap_dev.gold.next_purchase_predictions WHERE recommendation_rank = 1 GROUP BY recommended_product_name ORDER BY rank1_count DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "recommended_product_name",
            "expr": "recommended_product_name"
          }
        ],
        "measures": [
          {
            "name": "rank1_count",
            "expr": "SUM(rank1_count)"
          }
        ]
      }
    },
    {
      "name": "detailed_predictions",
      "displayName": "Detailed Customer Predictions",
      "config": {
        "version": "1.1",
        "source": "sap_dev.gold.next_purchase_predictions",
        "dimensions": [
          {
            "name": "customer_id",
            "expr": "customer_id"
          },
          {
            "name": "recommended_product_name",
            "expr": "recommended_product_name"
          },
          {
            "name": "recommendation_rank",
            "expr": "recommendation_rank"
          },
          {
            "name": "recommendation_score",
            "expr": "recommendation_score"
          },
          {
            "name": "prediction_date",
            "expr": "prediction_date"
          }
        ],
        "measures": [
          {
            "name": "total_predictions",
            "expr": "COUNT(*)"
          }
        ]
      }
    },
    {
      "name": "customer_coverage",
      "displayName": "Customer Recommendation Coverage",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  COUNT(DISTINCT customer_id) AS customers_with_recommendations,\n  COUNT(*) AS total_recommendations,\n  COUNT(*) * 1.0 / COUNT(DISTINCT customer_id) AS avg_recs_per_customer\nFROM sap_dev.gold.next_purchase_predictions\n",
        "dimensions": [],
        "measures": [
          {
            "name": "customers_with_recommendations",
            "expr": "SUM(customers_with_recommendations)"
          },
          {
            "name": "total_recommendations",
            "expr": "SUM(total_recommendations)"
          },
          {
            "name": "avg_recs_per_customer",
            "expr": "SUM(avg_recs_per_customer)"
          }
        ]
      }
    },
    {
      "name": "product_recommendations_with_pct",
      "displayName": "Product Recommendations with Percentage",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  recommended_product_name,\n  COUNT(*) AS recommendation_count,\n  COUNT(*) * 100.0 / SUM(COUNT(*)) OVER () AS pct_of_total\nFROM sap_dev.gold.next_purchase_predictions GROUP BY recommended_product_name ORDER BY recommendation_count DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "recommended_product_name",
            "expr": "recommended_product_name"
          }
        ],
        "measures": [
          {
            "name": "recommendation_count",
            "expr": "SUM(recommendation_count)"
          },
          {
            "name": "pct_of_total",
            "expr": "SUM(pct_of_total)"
          }
        ]
      }
    },
    {
      "name": "insights_data",
      "displayName": "Dashboard Insights Data",
      "config": {
        "version": "1.1",
        "source": "WITH product_stats AS (\n  SELECT\n    recommended_product_name,\n    COUNT(*) AS total_recs,\n    SUM(CASE WHEN recommendation_rank = 1 THEN 1 ELSE 0 END) AS rank1_recs\n  FROM sap_dev.gold.next_purchase_predictions\n  GROUP BY recommended_product_name\n), top_product AS (\n  SELECT recommended_product_name, total_recs\n  FROM product_stats\n  ORDER BY total_recs DESC\n  LIMIT 1\n), top_rank1_product AS (\n  SELECT recommended_product_name, rank1_recs\n  FROM product_stats\n  WHERE rank1_recs > 0\n  ORDER BY rank1_recs DESC\n  LIMIT 1\n), top5_concentration AS (\n  SELECT SUM(total_recs) * 100.0 / (SELECT COUNT(*) FROM sap_dev.gold.next_purchase_predictions) AS top5_pct\n  FROM (\n    SELECT total_recs\n    FROM product_stats\n    ORDER BY total_recs DESC\n    LIMIT 5\n  )\n) SELECT\n  (SELECT recommended_product_name FROM top_product) AS most_recommended_product,\n  (SELECT total_recs FROM top_product) AS most_recommended_count,\n  (SELECT recommended_product_name FROM top_rank1_product) AS top_rank1_product,\n  (SELECT rank1_recs FROM top_rank1_product) AS top_rank1_count,\n  (SELECT top5_pct FROM top5_concentration) AS top5_concentration_pct,\n  COUNT(DISTINCT p.customer_id) AS total_customers\nFROM sap_dev.gold.next_purchase_predictions p\n",
        "dimensions": [
          {
            "name": "most_recommended_product",
            "expr": "most_recommended_product"
          },
          {
            "name": "top_rank1_product",
            "expr": "top_rank1_product"
          }
        ],
        "measures": [
          {
            "name": "most_recommended_count",
            "expr": "SUM(most_recommended_count)"
          },
          {
            "name": "top_rank1_count",
            "expr": "SUM(top_rank1_count)"
          },
          {
            "name": "top5_concentration_pct",
            "expr": "SUM(top5_concentration_pct)"
          },
          {
            "name": "total_customers",
            "expr": "SUM(total_customers)"
          }
        ]
      }
    }
  ],
