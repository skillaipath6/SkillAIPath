[0m15:39:37.597646 [debug] [Thread-5 (]: On model.sap_dw.mart_product_performance: /* {"app": "dbt", "dbt_version": "1.12.6", "dbt_databricks_version": "1.13.0", "databricks_sql_connector_version": "4.4.0", "profile_name": "sap_dw", "target_name": "dev", "invocation_id": "2e744310-dff3-4a4a-a8b9-a3288008f18d", "node_id": "model.sap_dw.mart_product_performance"} */

  
    
