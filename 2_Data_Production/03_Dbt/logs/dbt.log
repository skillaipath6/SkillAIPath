[0m12:54:08.800200 [debug] [Thread-4 (]: On model.sap_dw.dim_date: /* {"app": "dbt", "dbt_version": "1.12.6", "dbt_databricks_version": "1.13.0", "databricks_sql_connector_version": "4.4.0", "profile_name": "sap_dw", "target_name": "dev", "invocation_id": "4b584fba-827d-4a77-afd5-6824e1c914b1", "node_id": "model.sap_dw.dim_date"} */

  
    
        create or replace table `sap_dev`.`silver`.`dim_date`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      -- dbt Intermediate Model: Date Dimension
-- Complete date dimension for time-based analysis



WITH date_spine AS (
  SELECT EXPLODE(SEQUENCE(
    TO_DATE('2020-01-01'),
    TO_DATE('2030-12-31'),
    INTERVAL 1 DAY
  )) AS Date
),

date_attributes AS (
  SELECT
    Date,
    YEAR(Date) AS Year,
    QUARTER(Date) AS QuarterNum,
    MONTH(Date) AS MonthNumber,
    DAYOFMONTH(Date) AS DayOfMonth,
    DAYOFWEEK(Date) AS DayOfWeekNumber,
    WEEKOFYEAR(Date) AS WeekOfYear,
    DATE_FORMAT(Date, 'MMMM') AS MonthName,
    DATE_FORMAT(Date, 'EEEE') AS DayOfWeek,
    CASE WHEN DAYOFWEEK(Date) IN (1, 7) THEN 1 ELSE 0 END AS IsWeekend
  FROM date_spine
)

SELECT
  ROW_NUMBER() OVER (ORDER BY Date) AS DateID,
  Date,
  Year,
  CONCAT('Q', QuarterNum) AS Quarter,
  MonthName,
  MonthNumber,
  DayOfMonth,
  DayOfWeek,
  DayOfWeekNumber,
  IsWeekend,
  WeekOfYear,
  Year AS FiscalYear,
  CONCAT('FQ', QuarterNum) AS FiscalQuarter
FROM date_attributes
  
