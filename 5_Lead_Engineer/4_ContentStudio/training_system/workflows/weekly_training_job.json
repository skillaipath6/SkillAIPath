{
  "name": "Weekly_AI_Training_Cycle",
  "description": "Autonomous training orchestrator - runs every Sunday at 2 AM UTC",
  "schedule": {
    "quartz_cron_expression": "0 0 2 ? * SUN",
    "timezone_id": "UTC"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "collect_logs",
      "description": "Collect and stage all training logs",
      "python_wheel_task": {
        "package_name": "training_orchestrator",
        "entry_point": "collect_logs"
      },
      "libraries": [
        {"pypi": {"package": "pandas"}},
        {"pypi": {"package": "requests"}}
      ]
    },
    {
      "task_key": "prepare_training_data",
      "depends_on": [{"task_key": "collect_logs"}],
      "description": "Consolidate logs into training dataset",
      "python_wheel_task": {
        "package_name": "training_orchestrator",
        "entry_point": "prepare_data"
      }
    },
    {
      "task_key": "train_model",
      "depends_on": [{"task_key": "prepare_training_data"}],
      "description": "Train AI model on consolidated dataset",
      "python_wheel_task": {
        "package_name": "training_orchestrator",
        "entry_point": "train_model"
      }
    },
    {
      "task_key": "verify_apps",
      "depends_on": [{"task_key": "train_model"}],
      "description": "Run health checks on all apps",
      "python_wheel_task": {
        "package_name": "training_orchestrator",
        "entry_point": "verify_apps"
      }
    },
    {
      "task_key": "deploy_model",
      "depends_on": [{"task_key": "verify_apps"}],
      "description": "Deploy trained model to production",
      "python_wheel_task": {
        "package_name": "training_orchestrator",
        "entry_point": "deploy_model"
      }
    }
  ],
  "email_notifications": {
    "on_failure": ["your-email@domain.com"],
    "on_success": ["your-email@domain.com"]
  },
  "timeout_seconds": 3600
}